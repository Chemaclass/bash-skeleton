#!/bin/bash
set -euo pipefail

# shellcheck disable=SC2034
declare -r BASH_SKELETON_VERSION="0.1.0"

BASH_SKELETON_ROOT_DIR="$(dirname "${BASH_SOURCE[0]}")"
export BASH_SKELETON_ROOT_DIR

source "$BASH_SKELETON_ROOT_DIR/src/dev/dumper.sh"
source "$BASH_SKELETON_ROOT_DIR/src/main.sh"
# Usage helper
function show_help() {
  cat <<EOF
Usage: $(basename "$0") [options] [args...]
  -h, --help          Show this help message
  -v, --version       Show script version
  -e, --env <file>    Load environment variables from file
  --debug             Enable debug mode
EOF
}
# Initialize _ARGS as an array
_ARGS=()

while [[ $# -gt 0 ]]; do
  argument="$1"
  case $argument in
    --debug)
      set -x
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    -v|--version)
      echo "$BASH_SKELETON_VERSION"
      exit 0
      ;;
    -e|--env)
      # shellcheck disable=SC1090
      source "$2"
      shift
      ;;
    *)
      _ARGS+=("$argument")
      ;;
  esac
  shift
done

main::action "${_ARGS[@]:-No args}"

echo "Script finished successfully."
